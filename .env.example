# MongoDB Atlas (Change Streams need a replica set; every Atlas cluster is one)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
# MONGODB_DB=scopeenvelope
# RUNS_COLLECTION=runs
# FOOTPRINTS_COLLECTION=footprints

# Agent model via OpenRouter (must support tool calling)
OPENROUTER_API_KEY=
MODEL=deepseek/deepseek-v4-pro

# Optional
# SCOPE_APPROVAL=auto        # auto | deny | prompt
# SCOPE_EMBED_MODEL=voyage-4-lite
